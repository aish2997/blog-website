# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Note: This project uses SQLite in both development and production
# Production uses /tmp/db.sqlite3 with GCS backup for persistence
# No database password is needed for SQLite

# Email (for production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-password

# Social Media Links
GITHUB_URL=https://github.com/yourusername
LINKEDIN_URL=https://linkedin.com/in/yourusername
TWITTER_URL=https://twitter.com/yourusername
EMAIL_CONTACT=your-email@example.com

# Site Configuration
SITE_NAME=Aishwarya Bhargava Portfolio
SITE_DESCRIPTION=Full Stack Developer & Software Engineer
PROFILE_IMAGE_PATH=profile.jpg