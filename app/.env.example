# =============================================================================
# Django Core Settings
# =============================================================================
DEBUG=True
SECRET_KEY=your-secret-key-here-generate-with-python-c-from-django.core.management.utils-import-get_random_secret_key-print-get_random_secret_key
ALLOWED_HOSTS=localhost,127.0.0.1

# Environment name (staging or production)
ENVIRONMENT=staging

# =============================================================================
# Database Configuration
# =============================================================================
# Option 1: Use DATABASE_URL for PostgreSQL (recommended for production)
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://user:password@your-neon-host.neon.tech:5432/your-database?sslmode=require

# Option 2: Individual PostgreSQL settings (alternative to DATABASE_URL)
DB_NAME=portfolio
DB_USER=postgres
DB_PASSWORD=your-password-here
DB_HOST=localhost
DB_PORT=5432

# SQLite path (for local development without PostgreSQL)
DATABASE_PATH=/tmp/db.sqlite3

# =============================================================================
# Google Cloud Platform Settings (Production)
# =============================================================================
GCP_PROJECT_ID=your-gcp-project-id

# GCS Buckets for static and media files
GCS_BUCKET_MEDIA=your-project-portfolio-media-production
GCS_BUCKET_STATIC=your-project-portfolio-static-production

# Cloud Run service URL (set automatically by Cloud Run)
CLOUD_RUN_SERVICE_URL=https://your-service.run.app

# Custom domain (if configured)
CUSTOM_DOMAIN=yourdomain.com

# =============================================================================
# Django Admin Superuser (for automated setup)
# =============================================================================
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=your-secure-admin-password
DJANGO_SUPERUSER_EMAIL=admin@example.com

# =============================================================================
# Email Configuration
# =============================================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For production SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=noreply@example.com

# =============================================================================
# Error Tracking (Sentry)
# =============================================================================
# Get your DSN from https://sentry.io
SENTRY_DSN=https://your-key@sentry.io/your-project-id
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# =============================================================================
# Site Configuration
# =============================================================================
SITE_NAME=Your Portfolio Name
SITE_DESCRIPTION=Full Stack Developer & Software Engineer
PROFILE_IMAGE_PATH=profile.jpg

# Social Media Links
GITHUB_URL=https://github.com/yourusername
LINKEDIN_URL=https://linkedin.com/in/yourusername
TWITTER_URL=https://twitter.com/yourusername
EMAIL_CONTACT=your-email@example.com

# =============================================================================
# Security Settings (Production)
# =============================================================================
# CSRF trusted origins (comma-separated)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://your-service.run.app

# =============================================================================
# Optional: Redis Cache (if using)
# =============================================================================
# REDIS_URL=redis://localhost:6379/0
